local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local KEY = Enum.KeyCode.H
local MESSAGE = "-gh 5268602207"

local HEIGHT = 4        -- how high you float (studs)
local RISE_TIME = 0.6   -- seconds to lift and turn sideways
local ROCK_ANGLE = 35   -- how far you tilt down and up (degrees)
local ROCK_SPEED = 2.5  -- how fast you rock

local floating = false
local connection
local baseCFrame

local function sendChat(text)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and channels:FindFirstChild("RBXGeneral")
		if channel then
			channel:SendAsync(text)
		end
	else
		local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local say = events and events:FindFirstChild("SayMessageRequest")
		if say then
			say:FireServer(text, "All")
		end
	end
end

local function getParts()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return root, humanoid
end

local function stopFloating()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	floating = false

	local root, humanoid = getParts()
	if root and humanoid then
		root.CFrame = baseCFrame -- back to standing upright
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = false
		humanoid.PlatformStand = false
	end
end

local function startFloating()
	local root, humanoid = getParts()
	if not root or not humanoid then return end

	floating = true
	sendChat(MESSAGE)

	-- Keep only your position and facing direction (no tilt)
	local _, yawAngle = root.CFrame:ToOrientation()
	baseCFrame = CFrame.new(root.Position) * CFrame.Angles(0, yawAngle, 0)

	humanoid.PlatformStand = true
	root.Anchored = true

	local startTime = os.clock()
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - startTime
		local ease = math.clamp(t / RISE_TIME, 0, 1)

		local roll = math.rad(90) * ease
			+ math.rad(ROCK_ANGLE) * math.sin(t * ROCK_SPEED) * ease

		root.CFrame = baseCFrame
			* CFrame.new(0, HEIGHT * ease, 0)
			* CFrame.Angles(0, 0, roll)
	end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or input.KeyCode ~= KEY then return end

	if floating then
		stopFloating()
	else
		startFloating()
	end
end)

