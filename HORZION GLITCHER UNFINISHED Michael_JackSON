local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local KEY = Enum.KeyCode.J
local MESSAGE = "-gh 5316539421"

local SIDE = 1            -- 1 = right side, -1 = left side
local SHOULDER = Vector3.new(1.5, 1, 0.8) -- where the wing "hinge" sits on you
local ARM_LENGTH = 3.5    -- how far the sword sits from the hinge
local FLAP_ANGLE = 40     -- degrees up and down
local FLAP_SPEED = 4      -- flaps speed
local WAIT_FOR_ITEM = 4   -- seconds to wait for the sword to appear

local floater
local connection

local function sendChat(text)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and channels:FindFirstChild("RBXGeneral")
		if channel then
			channel:SendAsync(text)
		end
	else
		local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local say = events and events:FindFirstChild("SayMessageRequest")
		if say then
			say:FireServer(text, "All")
		end
	end
end

-- Remember what you already own so we can spot the new sword
local function snapshot()
	local seen = {}
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({character, backpack}) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				seen[child] = true
			end
		end
	end
	return seen
end

local function findNewHandle(seen)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({character, backpack}) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if not seen[child] and (child:IsA("Tool") or child:IsA("Accessory")) then
					local handle = child:FindFirstChild("Handle")
					if handle and handle:IsA("BasePart") then
						return handle
					end
				end
			end
		end
	end
end

local function cleanup()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if floater then
		floater:Destroy()
		floater = nil
	end
end

local function startFloating(handle)
	cleanup()

	floater = handle:Clone()
	for _, d in ipairs(floater:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("JointInstance")
			or d:IsA("WeldConstraint") or d:IsA("TouchTransmitter") then
			d:Destroy()
		end
	end
	floater.Anchored = true
	floater.CanCollide = false
	floater.CanTouch = false
	floater.Massless = true
	floater.Parent = workspace

	local startTime = os.clock()
	connection = RunService.RenderStepped:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local t = os.clock() - startTime
		local flap = math.rad(FLAP_ANGLE) * math.sin(t * FLAP_SPEED)

		floater.CFrame = root.CFrame
			* CFrame.new(SHOULDER.X * SIDE, SHOULDER.Y, SHOULDER.Z)
			* CFrame.Angles(0, 0, flap * SIDE)          -- the wing flap
			* CFrame.new(ARM_LENGTH * SIDE, 0, 0)        -- sword out to the side
			* CFrame.Angles(0, 0, math.rad(90))          -- lying on its side
	end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or input.KeyCode ~= KEY then return end

	-- Press again to turn it off
	if floater then
		cleanup()
		return
	end

	local seen = snapshot()
	sendChat(MESSAGE)

	local deadline = os.clock() + WAIT_FOR_ITEM
	local handle
	while os.clock() < deadline do
		handle = findNewHandle(seen)
		if handle then break end
		task.wait(0.2)
	end

	if handle then
		startFloating(handle)
	else
		warn("No new sword showed up after the chat command.")
	end
end)

player.CharacterAdded:Connect(cleanup)
