local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local KEY = Enum.KeyCode.G
local MESSAGE = "-gh 5316479641"
local SPIN_TIME = 1 -- seconds for the full spin

local busy = false

local function sendChat(text)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channel = TextChatService:FindFirstChild("TextChannels")
			and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
		if channel then
			channel:SendAsync(text)
		end
	else
		-- Legacy chat fallback
		local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local say = events and events:FindFirstChild("SayMessageRequest")
		if say then
			say:FireServer(text, "All")
		end
	end
end

local function spin360()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- Tweening a number instead of the CFrame, because tweening
	-- straight to a 360° turn would look like no movement at all
	local angle = Instance.new("NumberValue")
	local startCFrame = root.CFrame

	local connection = angle.Changed:Connect(function(value)
		root.CFrame = CFrame.new(root.Position) * (startCFrame - startCFrame.Position)
			* CFrame.Angles(0, math.rad(value), 0)
	end)

	local tween = TweenService:Create(angle, TweenInfo.new(SPIN_TIME, Enum.EasingStyle.Linear), {Value = 360})
	tween:Play()
	tween.Completed:Wait()

	connection:Disconnect()
	angle:Destroy()
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or input.KeyCode ~= KEY or busy then return end
	busy = true

	sendChat(MESSAGE)
	spin360()

	busy = false
end)
