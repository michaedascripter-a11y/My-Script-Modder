local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local TITLE_TEXT = "Mayhem"
local TITLE_FONT = Enum.Font.Creepster -- try: Bangers, LuckiestGuy, FredokaOne, PermanentMarker
local TITLE_COLOR = Color3.fromRGB(255, 60, 60)
local OUTLINE_COLOR = Color3.fromRGB(0, 0, 0)

local function addTitle(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	-- Remove any old title so it never stacks
	local old = head:FindFirstChild("MayhemTitle")
	if old then old:Destroy() end

	local gui = Instance.new("BillboardGui")
	gui.Name = "MayhemTitle"
	gui.Size = UDim2.new(0, 220, 0, 60)
	gui.StudioOffset = Vector3.new(0, 2.2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 100
	gui.Adornee = head
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = TITLE_TEXT
	label.Font = TITLE_FONT
	label.TextScaled = true
	label.TextColor3 = TITLE_COLOR
	label.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Color = OUTLINE_COLOR
	stroke.Thickness = 2.5
	stroke.Parent = label

	-- Color gradient for the "cool" look
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 170, 0)),
	})
	gradient.Rotation = 90
	gradient.Parent = label

	-- Wobble: rocks left and right forever
	label.Rotation = -8
	local wobble = TweenService:Create(
		label,
		TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{Rotation = 8}
	)
	wobble:Play()

	-- Gentle bob up and down
	local bob = TweenService:Create(
		gui,
		TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{StudioOffset = Vector3.new(0, 2.6, 0)}
	)
	bob:Play()
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(addTitle)
end)

-- In case players joined before the script loaded
for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		addTitle(player.Character)
	end
	player.CharacterAdded:Connect(addTitle)
end

