-- ANIMATION SETTING  --
local RunService = game:GetService("RunService")

local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local torso = character:WaitForChild("Torso")
local root = character:WaitForChild("HumanoidRootPart")

local HEIGHT = 3        -- how high you float (studs)
local BOB_AMOUNT = 0.4  -- how much you move up and down
local BOB_SPEED = 2
local SWAY = 12         -- limb sway in degrees

-- Stop the default walking animation from fighting this one
local animate = character:FindFirstChild("Animate")
if animate then animate.Disabled = true end
for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
	track:Stop()
end

local rightShoulder = torso:WaitForChild("Right Shoulder")
local leftShoulder = torso:WaitForChild("Left Shoulder")
local rightHip = torso:WaitForChild("Right Hip")
local leftHip = torso:WaitForChild("Left Hip")
local neck = torso:WaitForChild("Neck")
local rootJoint = root:WaitForChild("RootJoint")

local base = {
	[rightShoulder] = rightShoulder.C0,
	[leftShoulder] = leftShoulder.C0,
	[rightHip] = rightHip.C0,
	[leftHip] = leftHip.C0,
	[neck] = neck.C0,
	[rootJoint] = rootJoint.C0,
}

local startTime = os.clock()

RunService.RenderStepped:Connect(function()
	if humanoid.Health <= 0 then return end

	local t = os.clock() - startTime
	local wave = math.sin(t * BOB_SPEED)
	local slow = math.sin(t * BOB_SPEED * 0.5)

	-- Float and bob
	humanoid.HipHeight = HEIGHT + wave * BOB_AMOUNT

	-- Arms drift outward and sway
	rightShoulder.C0 = base[rightShoulder] * CFrame.Angles(0, 0, math.rad(25 + wave * SWAY))
	leftShoulder.C0 = base[leftShoulder] * CFrame.Angles(0, 0, math.rad(-25 - wave * SWAY))

	-- Legs dangle and swing a little
	rightHip.C0 = base[rightHip] * CFrame.Angles(0, 0, math.rad(wave * SWAY * 0.6))
	leftHip.C0 = base[leftHip] * CFrame.Angles(0, 0, math.rad(wave * SWAY * 0.6))

	-- Slight body lean and head tilt
	rootJoint.C0 = base[rootJoint] * CFrame.Angles(math.rad(slow * 4), 0, math.rad(slow * 3))
	neck.C0 = base[neck] * CFrame.Angles(math.rad(-slow * 3), 0, 0)
end)
